QWidget {
    background-color: #1e1f26;
    color: #f0f0f0;
    font-family: "Segoe UI";
}


QLabel {
    color: #e6e6e6;
    font-size: 11pt;
}

QSpinBox {
    background-color: #2c2f3a;
    border: 2px solid #4c566a;
    border-radius: 8px;
    padding: 5px;
    color: white;
    selection-background-color: #5e81ac;
}

QSpinBox:hover {
    border: 2px solid #88c0d0;
}

/* Выпадающий список */
QComboBox {
    background-color: #2c2f3a;
    border: 2px solid #4c566a;
    border-radius: 8px;
    padding: 5px;
    color: white;
}

QComboBox:hover {
    border: 2px solid #88c0d0;
}

QComboBox QAbstractItemView {
    background-color: #2c2f3a;
    color: white;
    selection-background-color: #5e81ac;
}


QPushButton {
    background-color: #b39252;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 8px;
    font-size: 12pt;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #856d3d;
}

QPushButton:pressed {
    background-color: #b39252;
}

/* Главная кнопка запуска */
QPushButton[text="Начать моделирование"] {
    background-color: #85545d;
    font-size: 16pt;
}

QPushButton[text="Начать моделирование"]:hover {
    background-color: #5c393f;
}


QScrollBar:vertical {
    background: #2c2f3a;
    width: 12px;
}

QScrollBar::handle:vertical {
    background: #5e81ac;
    border-radius: 5px;
}
