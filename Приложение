    def start_simulation(self):
        selected_mode = self.combo_mode.currentText()
        self.game = Game(amount=int(self.put_amount.text()),
                         temperature=int(self.put_temp.text()),
                         mode=selected_mode)
        self.game.spawn_particles()

        # Автоматически открываем окно графиков при старте
        self.show_graphs_window()

        self.timer = QTimer()
        self.timer.timeout.connect(self.pygame_loop)
        self.timer.start(30)

    def show_graphs_window(self):
        if self.game:
            if self.graph_window is not None:
                self.graph_window.close()
            self.graph_window = RealTimeGraphWindow(self.game)
            self.graph_window.show()

    def pygame_loop(self):
        if self.game:
            self.game.loop()
            self.label_v_quad.setText(f'Средняя квадратичная скорость:\n{round(self.game.v_quad * 100)} м/с')
            if len(self.game.list_press) > 0:
                self.label_press.setText(
                    f'Давление: {str(self.game.list_press[-1])[:7]} Н/м')

            # Обновление окна с графиками
            if self.graph_window and self.graph_window.isVisible():
                if random.random() < 0.15 or self.game.t == 49:
                    self.graph_window.update_charts()

            self.update(0, 0, 500, 500)

    def paintEvent(self, e):
        p = QPainter(self)
        if self.game:
            buf = self.game.screen.get_buffer()
            img = QImage(buf, 500, 500, QImage.Format_RGB32)
            p.drawImage(0, 0, img)
        else:
            # Черный экран до запуска симуляции
            p.fillRect(0, 0, 500, 500, QtGui.QColor(0, 0, 0))


